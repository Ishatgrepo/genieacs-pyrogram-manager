# Copy to .env; use independent random hex tokens (openssl rand -hex 32).
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=0
TELEGRAM_ADMIN_IDS=
BOT_ENABLED=true
API_TOKEN=
BOT_API_TOKEN=

# full: all processes on VPS; core: API/workers only; hybrid: Space bot + gateway.
DEPLOYMENT_MODE=full
APP_PORT=7860
CORE_API_URL=https://manager.example.com
GENIEACS_NBI_URL=http://nbi:7557
GENIEACS_NBI_AUTH_TOKEN=
# Compose overrides this with the internal URI; local/external deployments must set it.
MONGODB_URI=mongodb://localhost:27017
APP_DATABASE_NAME=genieacs_manager
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
MONGO_ACS_PASSWORD=
GENIEACS_UI_JWT_SECRET=
MANAGER_HOST=manager.example.com
CWMP_HOST=acs.example.com
CPE_USERNAME=
CPE_PASSWORD=

DEVICE_DISCOVERY_INTERVAL=10
DEVICE_STATUS_INTERVAL=30
METRICS_COLLECTION_INTERVAL=300
DEVICE_ACTIVE_THRESHOLD=600
DEVICE_OFFLINE_THRESHOLD=1800
REQUIRE_DEVICE_APPROVAL=true
ALLOW_HIGH_RISK_ACTIONS=false
NOTIFY_NEW_DEVICES=true
NOTIFY_OFFLINE=true
NOTIFY_RECONNECTED=true
NOTIFY_TASK_FAILURES=true
RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
WORKER_CONCURRENCY=8
MAX_BULK_DEVICES=100
TASK_TIMEOUT=3600
MONITOR_INTERVAL=30
MONITOR_TTL=900
MAX_MONITOR_SESSIONS=50
# Exact paths only, JSON array. Never add password/debug/security-bypass parameters.
PARAMETER_ALLOWLIST=[]
# Enable only RPCs verified on your actual model, e.g. {"ExampleModel":["reboot"]}.
MODEL_CAPABILITIES={}
# {"release-id":{"model":"ExampleModel","file":"approved.bin","version":"1.2","sha256":"..."}}
FIRMWARE_CATALOG={}
# Exact vendor paths and known counter widths, no guessed unit conversions.
METRIC_PROFILES={}
QUIET_HOURS_START=0
QUIET_HOURS_END=0
ENABLE_SCHEDULED_REPORTS=false
REPORT_INTERVAL_HOURS=24
REPORT_SCHEDULE=daily
ALERT_COOLDOWN=300
TZ=Asia/Kolkata
LOG_LEVEL=INFO
